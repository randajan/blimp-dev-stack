{
  "name": "@randajan/blimp-dev-stack",
  "version": "0.1.0",
  "description": "Shared React components, global styles, and game-domain utilities for the Blimp ecosystem.",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./ui": {
      "import": "./dist/esm/ui/index.mjs",
      "require": "./dist/cjs/ui/index.cjs"
    },
    "./graphs": {
      "import": "./dist/esm/graphs/index.mjs",
      "require": "./dist/cjs/graphs/index.cjs"
    },
    "./stats": {
      "import": "./dist/esm/stats/index.mjs",
      "require": "./dist/cjs/stats/index.cjs"
    },
    "./game": {
      "import": "./dist/esm/game/index.mjs",
      "require": "./dist/cjs/game/index.cjs"
    },
    "./time": {
      "import": "./dist/esm/time/index.mjs",
      "require": "./dist/cjs/time/index.cjs"
    },
    "./locale": {
      "import": "./dist/esm/locale/index.mjs",
      "require": "./dist/cjs/locale/index.cjs"
    },
    "./styles": {
      "import": "./dist/esm/styles/index.mjs",
      "require": "./dist/cjs/styles/index.cjs"
    },
    "./styles/fn": "./src/styles/_fn.scss",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ./index.js isBuild=true",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/randajan/blimp-dev-stack.git"
  },
  "homepage": "https://github.com/randajan/blimp-dev-stack#readme",
  "bugs": {
    "url": "https://github.com/randajan/blimp-dev-stack/issues"
  },
  "keywords": [
    "blimp",
    "react",
    "components",
    "scss",
    "data-view",
    "charts",
    "statistics",
    "game"
  ],
  "author": {
    "name": "Jan Randa",
    "email": "jnranda@gmail.com",
    "url": "https://www.linkedin.com/in/randajan/"
  },
  "license": "MIT",
  "devDependencies": {
    "@randajan/simple-lib": "^5.0.1",
    "esbuild-sass-plugin": "^3.3.1",
    "sass": "^1.89.2"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@randajan/jet-base": "^2.3.2",
    "@randajan/jet-core": "^4.1.0",
    "@randajan/jet-react": "^3.3.4",
    "@randajan/say": "^2.4.1",
    "@tanstack/react-table": "^9.3.1",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.17",
    "query-string": "^10.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intersection-observer": "^11.0.1",
    "react-transition-group": "^4.4.5"
  }
}
